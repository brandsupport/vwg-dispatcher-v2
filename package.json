{
  "name": "vwg-dispatcher-v2-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-worker-assets.mjs",
    "dev": "npm run prepare:assets && wrangler dev",
    "deploy": "npm run prepare:assets && wrangler deploy",
    "db:local": "wrangler d1 migrations apply vwg-dispatcher-staging --local",
    "db:remote": "wrangler d1 migrations apply vwg-dispatcher-staging --remote",
    "check": "node --check worker/index.js && node --check scripts/prepare-worker-assets.mjs"
  },
  "dependencies": {
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
